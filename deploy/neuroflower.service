[Unit]
Description=Stepa plant companion
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=neuroflower
Group=neuroflower
WorkingDirectory=/opt/neuroflower/app
ExecStart=/opt/neuroflower/venv/bin/python -u /opt/neuroflower/app/bot.py --config /var/lib/neuroflower/config.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StateDirectory=neuroflower
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neuroflower
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=96M
MemoryMax=160M
TasksMax=48

[Install]
WantedBy=multi-user.target
